    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.7",
    "fast-xml-parser": "^5.11.2",
    "htmlparser2": "^12.0.0",
